{
  "name": "@let-value/unwind",
  "version": "0.1.1-beta.6",
  "description": "A CLI codemod tool powered by jscodeshift",
  "bin": {
    "unwind": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "vitest": "vitest",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "test:browser": "vitest --config vitest.browser.config.ts run",
    "compile:shadcn": "node --experimental-strip-types src/test/shadcn/compiledSetup.ts",
    "release": "bumpp",
    "publish:pkg": "npm publish"
  },
  "dependencies": {
    "@tailwindcss/node": "4.2.2",
    "jscodeshift": "17.3.0",
    "oxc-resolver": "^11.19.1",
    "postcss": "8.5.8",
    "postcss-nested": "7.0.2",
    "postcss-selector-parser": "7.1.1",
    "postcss-value-parser": "4.2.0",
    "tailwindcss": "4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser-playwright": "4.1.2",
    "@vitest/coverage-v8": "4.1.2",
    "bumpp": "^11.0.1",
    "lucide-react": "1.31.0",
    "oxfmt": "0.43.0",
    "oxlint": "1.58.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn-compiled": "workspace:*",
    "shadcn-test": "workspace:shadcn@*",
    "sonner": "^2.0.8",
    "tsdown": "0.21.7",
    "typescript": "6.0.2",
    "vite": "^8.0.3",
    "vitest": "4.1.2",
    "vitest-browser-react": "2.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
