"@layer properties, theme, base, components, utilities;
@layer components {
    .button {
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: calc(var(--radius) * 0.8);
        border-style: var(--tw-border-style);
        border-width: 1px;
        border-color: transparent;
        background-clip: padding-box;
        font-size: var(--text-sm);
        line-height: var(--tw-leading, var(--text-sm--line-height));
        --tw-font-weight: var(--font-weight-medium);
        font-weight: var(--font-weight-medium);
        white-space: nowrap;
        transition-property: all;
        transition-timing-function: var(--tw-ease, var(--default-transition-timing-function));
        transition-duration: var(--tw-duration, var(--default-transition-duration));
        --tw-outline-style: none;
        outline-style: none;
        -webkit-user-select: none;
        user-select: none;
    }
    .button:focus-visible {
        border-color: var(--ring);
        --tw-ring-shadow: var(--tw-ring-inset,) 0 0 0 calc(3px + var(--tw-ring-offset-width)) var(--tw-ring-color, currentcolor);
        box-shadow: var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow);
        --tw-ring-color: var(--ring);
    }
    @supports (color: color-mix(in lab, red, red)) {
        .button:focus-visible {
            --tw-ring-color: color-mix(in oklab, var(--ring) 50%, transparent)
        }
    }
    .button:active:not(*[aria-haspopup]) {
        --tw-translate-y: 1px;
        translate: var(--tw-translate-x) var(--tw-translate-y);
    }
    .button:disabled {
        pointer-events: none;
        opacity: 50%;
    }
    .button[aria-invalid="true"] {
        border-color: var(--destructive);
        --tw-ring-shadow: var(--tw-ring-inset,) 0 0 0 calc(3px + var(--tw-ring-offset-width)) var(--tw-ring-color, currentcolor);
        box-shadow: var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow);
        --tw-ring-color: var(--destructive);
    }
    @supports (color: color-mix(in lab, red, red)) {
        .button[aria-invalid="true"] {
            --tw-ring-color: color-mix(in oklab, var(--destructive) 20%, transparent)
        }
    }
    .button:is(:global(.dark) *)[aria-invalid="true"] {
        border-color: var(--destructive);
        --tw-ring-color: var(--destructive);
    }
    @supports (color: color-mix(in lab, red, red)) {
        .button:is(:global(.dark) *)[aria-invalid="true"] {
            border-color: color-mix(in oklab, var(--destructive) 50%, transparent);
            --tw-ring-color: color-mix(in oklab, var(--destructive) 40%, transparent)
        }
    }
    .button svg {
        pointer-events: none;
        flex-shrink: 0;
    }
    .button svg:not([class*='size-']) {
        width: calc(var(--spacing) * 4);
        height: calc(var(--spacing) * 4);
    }
    .button-variant-default {
        background-color: var(--primary);
        color: var(--primary-foreground);
    }
    @media (hover: hover) {
        .button-variant-default:hover {
            background-color: var(--primary)
        }
        @supports (color: color-mix(in lab, red, red)) {
            .button-variant-default:hover {
                background-color: color-mix(in oklab, var(--primary) 80%, transparent)
            }
        }
        .button-variant-outline:hover {
            background-color: var(--muted);
            color: var(--foreground)
        }
        .button-variant-outline:is(:global(.dark) *):hover {
            background-color: var(--input)
        }
        @supports (color: color-mix(in lab, red, red)) {
            .button-variant-outline:is(:global(.dark) *):hover {
                background-color: color-mix(in oklab, var(--input) 50%, transparent)
            }
        }
        .button-variant-secondary:hover {
            background-color: var(--secondary)
        }
        @supports (color: color-mix(in lab, red, red)) {
            .button-variant-secondary:hover {
                background-color: color-mix(in oklch,var(--secondary),var(--foreground) 5%)
            }
        }
        .button-variant-ghost:hover {
            background-color: var(--muted);
            color: var(--foreground)
        }
        .button-variant-ghost:is(:global(.dark) *):hover {
            background-color: var(--muted)
        }
        @supports (color: color-mix(in lab, red, red)) {
            .button-variant-ghost:is(:global(.dark) *):hover {
                background-color: color-mix(in oklab, var(--muted) 50%, transparent)
            }
        }
        .button-variant-destructive:hover {
            background-color: var(--destructive)
        }
        @supports (color: color-mix(in lab, red, red)) {
            .button-variant-destructive:hover {
                background-color: color-mix(in oklab, var(--destructive) 20%, transparent)
            }
        }
        .button-variant-destructive:is(:global(.dark) *):hover {
            background-color: var(--destructive)
        }
        @supports (color: color-mix(in lab, red, red)) {
            .button-variant-destructive:is(:global(.dark) *):hover {
                background-color: color-mix(in oklab, var(--destructive) 30%, transparent)
            }
        }
        .button-variant-link:hover {
            text-decoration-line: underline
        }
    }
    .button-variant-outline {
        border-color: var(--border);
        background-color: var(--background);
        --tw-shadow: 0 1px 2px 0 var(--tw-shadow-color, rgb(0 0 0 / 0.05));
        box-shadow: var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow);
    }
    .button-variant-outline[aria-expanded="true"] {
        background-color: var(--muted);
        color: var(--foreground);
    }
    .button-variant-outline:is(:global(.dark) *) {
        border-color: var(--input);
        background-color: var(--input);
    }
    @supports (color: color-mix(in lab, red, red)) {
        .button-variant-outline:is(:global(.dark) *) {
            background-color: color-mix(in oklab, var(--input) 30%, transparent)
        }
    }
    .button-variant-secondary {
        background-color: var(--secondary);
        color: var(--secondary-foreground);
    }
    .button-variant-secondary[aria-expanded="true"] {
        background-color: var(--secondary);
        color: var(--secondary-foreground);
    }
    .button-variant-ghost[aria-expanded="true"] {
        background-color: var(--muted);
        color: var(--foreground);
    }
    .button-variant-destructive {
        background-color: var(--destructive);
        color: var(--destructive);
    }
    @supports (color: color-mix(in lab, red, red)) {
        .button-variant-destructive {
            background-color: color-mix(in oklab, var(--destructive) 10%, transparent)
        }
    }
    .button-variant-destructive:focus-visible {
        border-color: var(--destructive);
        --tw-ring-color: var(--destructive);
    }
    @supports (color: color-mix(in lab, red, red)) {
        .button-variant-destructive:focus-visible {
            border-color: color-mix(in oklab, var(--destructive) 40%, transparent);
            --tw-ring-color: color-mix(in oklab, var(--destructive) 20%, transparent)
        }
    }
    .button-variant-destructive:is(:global(.dark) *) {
        background-color: var(--destructive);
    }
    @supports (color: color-mix(in lab, red, red)) {
        .button-variant-destructive:is(:global(.dark) *) {
            background-color: color-mix(in oklab, var(--destructive) 20%, transparent)
        }
    }
    .button-variant-destructive:is(:global(.dark) *):focus-visible {
        --tw-ring-color: var(--destructive);
    }
    @supports (color: color-mix(in lab, red, red)) {
        .button-variant-destructive:is(:global(.dark) *):focus-visible {
            --tw-ring-color: color-mix(in oklab, var(--destructive) 40%, transparent)
        }
    }
    .button-variant-link {
        color: var(--primary);
        text-underline-offset: 4px;
    }
    .button-size-default {
        height: calc(var(--spacing) * 9);
        gap: calc(var(--spacing) * 1.5);
        padding-inline: calc(var(--spacing) * 2.5);
    }
    :where(*[data-slot="button-group"]) .button-size-default {
        border-radius: calc(var(--radius) * 0.8);
    }
    .button-size-default:has(*[data-icon="inline-end"]) {
        padding-right: calc(var(--spacing) * 2);
    }
    .button-size-default:has(*[data-icon="inline-start"]) {
        padding-left: calc(var(--spacing) * 2);
    }
    .button-size-xs {
        height: calc(var(--spacing) * 6);
        gap: calc(var(--spacing) * 1);
        border-radius: min(var(--radius-md), 8px);
        padding-inline: calc(var(--spacing) * 2);
        font-size: var(--text-xs);
        line-height: var(--tw-leading, var(--text-xs--line-height));
    }
    :where(*[data-slot="button-group"]) .button-size-xs {
        border-radius: calc(var(--radius) * 0.8);
    }
    .button-size-xs:has(*[data-icon="inline-end"]) {
        padding-right: calc(var(--spacing) * 1.5);
    }
    .button-size-xs:has(*[data-icon="inline-start"]) {
        padding-left: calc(var(--spacing) * 1.5);
    }
    .button-size-xs svg:not([class*='size-']) {
        width: calc(var(--spacing) * 3);
        height: calc(var(--spacing) * 3);
    }
    .button-size-sm {
        height: calc(var(--spacing) * 8);
        gap: calc(var(--spacing) * 1);
        border-radius: min(var(--radius-md), 10px);
        padding-inline: calc(var(--spacing) * 2.5);
    }
    :where(*[data-slot="button-group"]) .button-size-sm {
        border-radius: calc(var(--radius) * 0.8);
    }
    .button-size-sm:has(*[data-icon="inline-end"]) {
        padding-right: calc(var(--spacing) * 1.5);
    }
    .button-size-sm:has(*[data-icon="inline-start"]) {
        padding-left: calc(var(--spacing) * 1.5);
    }
    .button-size-lg {
        height: calc(var(--spacing) * 10);
        gap: calc(var(--spacing) * 1.5);
        padding-inline: calc(var(--spacing) * 2.5);
    }
    .button-size-lg:has(*[data-icon="inline-end"]) {
        padding-right: calc(var(--spacing) * 2);
    }
    .button-size-lg:has(*[data-icon="inline-start"]) {
        padding-left: calc(var(--spacing) * 2);
    }
    .button-size-icon {
        width: calc(var(--spacing) * 9);
        height: calc(var(--spacing) * 9);
    }
    .button-size-icon-xs {
        width: calc(var(--spacing) * 6);
        height: calc(var(--spacing) * 6);
        border-radius: min(var(--radius-md), 8px);
    }
    :where(*[data-slot="button-group"]) .button-size-icon-xs {
        border-radius: calc(var(--radius) * 0.8);
    }
    .button-size-icon-xs svg:not([class*='size-']) {
        width: calc(var(--spacing) * 3);
        height: calc(var(--spacing) * 3);
    }
    .button-size-icon-sm {
        width: calc(var(--spacing) * 8);
        height: calc(var(--spacing) * 8);
        border-radius: min(var(--radius-md), 10px);
    }
    :where(*[data-slot="button-group"]) .button-size-icon-sm {
        border-radius: calc(var(--radius) * 0.8);
    }
    .button-size-icon-lg {
        width: calc(var(--spacing) * 10);
        height: calc(var(--spacing) * 10);
    }
}"
`;
