exports[`compileTailwindClasses > snapshots custom selector 1`] = `
".compiled {\\n  font-size: var(--text-sm);\\n    line-height: var(--tw-leading, var(--text-sm--line-height));\\n  --tw-font-weight: var(--font-weight-medium);\\n    font-weight: var(--font-weight-medium);\\n}"
`;

exports[`compileTailwindClasses > snapshots merged utilities 1`] = `
".output {\\n  padding: calc(var(--spacing) * 4);\\n  background-color: var(--color-blue-500);\\n}"
`;

exports[`compileTailwindClasses > snapshots regular and hover utilities 1`] = `
".output {\\n  padding: calc(var(--spacing) * 4);\\n}\\n\\n.output:hover {\\n  @media (hover: hover) {\\n        background-color: var(--color-blue-600);\\n      }\\n}"
`;

exports[`compileTailwindClasses > snapshots single utility 1`] = `
